# =============================================================
#  .gitignore — BelgianEid (.NET 8, Windows)
# =============================================================


# ── .NET build output ─────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Pp]ublish/


# ── NuGet ─────────────────────────────────────────────────────
*.nupkg
*.snupkg
.nuget/
# project.assets.json is regenerated by `dotnet restore` (already
# covered by obj/, listed here for clarity).


# ── Test results ──────────────────────────────────────────────
[Tt]est[Rr]esults/
*.trx
*.coveragexml
coverage*/
**/coverage.cobertura.xml


# ── Visual Studio ─────────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/


# ── JetBrains Rider ───────────────────────────────────────────
.idea/
*.sln.iml

# ── Zed ───────────────────────────────────────────────────────
.zed/


# ── Logs and temporary files ──────────────────────────────────
*.log
*.tmp
*.temp
crash-*.json


# ── Secrets and local configuration ───────────────────────────
# Never commit secrets or local overrides.
appsettings.local.json
appsettings.*.local.json
secrets.json
*.pfx
*.p12
*.key
*.pem

# ── Installer — generated artifacts ───────────────────────────
# Produced by installer/build.ps1, do not commit.
installer/artifacts/
installer/output/

# Chrome extension signing key — already covered by *.pem above.
# This file is CRITICAL: losing it changes the extension ID on
# machines where it is already installed. Store it in a secrets
# manager (e.g. KeePass, Bitwarden).
installer/extension-key.pem

# ── Extension — packaging output ──────────────────────────────
# build.ps1 asks Chrome to pack the extension, producing these
# next to the extension/ folder before they are moved into artifacts/.
extension.crx
extension.pem

# ── Bridge — dev publish directory ────────────────────────────
# Created by installer/build.ps1 to sync the dev bridge (HKCU).
bridge/publish/

# Generated Native Messaging host manifest (machine-specific path).
# Only the *.template.json is committed.
bridge/be.belgianeid.bridge.json


# ── Console sample output ─────────────────────────────────────
# samples/Program.cs writes the photo into the working directory.
photo.jpeg


# ── Native beidpkcs11 library ─────────────────────────────────
# The DLL under library/native/win-x64/ IS committed on purpose
# (needed for the bundled build — LGPLv3 license).
#
# If you would rather NOT commit it (system-wide middleware or Git
# LFS), uncomment the following line:
# library/native/**/*.dll


# ── Operating system ──────────────────────────────────────────

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
